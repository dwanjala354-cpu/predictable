# Predictable configuration. Loaded by "npm start" (node --env-file=.env). Never commit this file.

# --- Server ---
PORT=3000
NODE_ENV=development
# Set to 1 when running behind a reverse proxy (nginx, Caddy, a load balancer)
TRUST_PROXY=0

# --- Database ---
# Leave DATABASE_URL empty to use the embedded database stored in DATABASE_DIR.
# For real PostgreSQL: postgres://user:password@host:5432/predictable
DATABASE_URL=
DATABASE_DIR=./data
DB_POOL_MAX=10

# --- Security ---

# Seals authenticator secrets at rest. Required in production. Changing it later locks out existing staff authenticators.
PREDICTABLE_SECRET_KEY=5b617f20c507d6f1676a97c55082ab2c4793e361a58073e5baf7c0187ed685a4
# Initial password for the demo and staff accounts, used on first start only.
PREDICTABLE_STAFF_PASSWORD="PrDhS7KktTIkv4wi7P#26"
PREDICTABLE_REQUIRE_STAFF_MFA=1
PREDICTABLE_REQUIRE_WITHDRAWAL_OTP=1

# --- Demo data ---
# 1 = seed demo players, staff and markets on first start. Set 0 for a clean install.
PREDICTABLE_DEMO=1

# --- SMS ---
# simulated = codes appear in the player's notifications. "provider" needs a gateway implemented in src/sms.js.
SMS_MODE=simulated
# QUIET_SMS=1 stops simulated codes printing to the console.
QUIET_SMS=

# --- Rate limits (requests per minute per client) ---
RATE_LIMIT_API=600
RATE_LIMIT_AUTH=30
# RATE_LIMIT=off disables limits. Use only for tests.
RATE_LIMIT=
